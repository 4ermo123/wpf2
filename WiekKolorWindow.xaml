<Window x:Class="AnkietaWPF.WiekKolorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ankieta - wiek i kolor"
        Height="400" Width="400"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="25">
        <TextBlock Text="Dane ankietowanego"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Podaj swój wiek:" FontSize="15"/>

        <TextBox x:Name="txtWiek"
                 Height="30"
                 Margin="0,5,0,15"/>

        <TextBlock Text="Wybierz ulubiony kolor:"
                   FontSize="15"/>

        <ComboBox x:Name="cmbKolor"
                  Height="30"
                  Margin="0,5,0,15"
                  SelectedIndex="0">
            <ComboBoxItem Content="Czarny"/>
            <ComboBoxItem Content="Biały"/>
            <ComboBoxItem Content="Czerwony"/>
            <ComboBoxItem Content="Niebieski"/>
            <ComboBoxItem Content="Zielony"/>
            <ComboBoxItem Content="Żółty"/>
            <ComboBoxItem Content="Pomarańczowy"/>
            <ComboBoxItem Content="Fioletowy"/>
            <ComboBoxItem Content="Różowy"/>
            <ComboBoxItem Content="Szary"/>
        </ComboBox>

        <Button Content="Zapisz ankietę"
                Height="35"
                Click="Zapisz_Click"/>

        <Button Content="Pokaż statystyki"
                Height="35"
                Margin="0,10,0,0"
                Click="Statystyki_Click"/>
    </StackPanel>
</Window>
