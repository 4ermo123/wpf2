<Window x:Class="AnkietaWPF.StatystykiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statystyki ankiety"
        Height="400" Width="480"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="25">
        <TextBlock Text="STATYSTYKI ANKIETY"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock x:Name="txtLiczba"
                   FontSize="15"
                   Margin="0,5"/>

        <TextBlock x:Name="txtPlec"
                   FontSize="15"
                   TextWrapping="Wrap"
                   Margin="0,5"/>

        <TextBlock x:Name="txtKolor"
                   FontSize="15"
                   TextWrapping="Wrap"
                   Margin="0,5"/>

        <TextBlock x:Name="txtWiek"
                   FontSize="15"
                   Margin="0,5"/>

        <Button Content="Odśwież statystyki"
                Height="35"
                Margin="0,20,0,5"
                Click="Odswiez_Click"/>

        <Button Content="Zamknij"
                Height="35"
                Click="Zamknij_Click"/>
    </StackPanel>
</Window>
